// The site on Cloudflare: the build in dist/, served as static assets, with public/_headers. A small Worker
// (site/worker.ts) runs first only for the preview cards ("/card", "/card/*"); every other path, the home page and
// each app's page among them, is the assets alone, which Cloudflare serves without counting them. The link shortener
// is its own Worker (tinier/).
//
// Until 2026-10-15 the Worker also ran first for "/" and each app's page, to put a card's tags on a page opened with
// ?c=<id>: on launch day that put every visit through the Worker, past the free plan's 100,000 requests a day
// (124,273 by noon), and Cloudflare answered the pages with 429 (Paul: "we just broke through cloudflare's free tier
// and the site is down"). A page opened with ?c= is now the page as built, with the app's own tags; the card's
// picture (/card/<id>.png) still comes.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tinylittleoffice",
  "main": "site/worker.ts",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // The cards alone (test/cards.test.ts holds it): a page is never the Worker's.
    "run_worker_first": ["/card", "/card/*"],
  },
  // The cards are kept in the shortener's database (tinier/wrangler.jsonc, tinier/migrations/), whose sweep forgets them.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tinier",
      "database_id": "6ede155f-083c-4ab9-a33e-64eea0704bb5",
      "migrations_dir": "tinier/migrations",
    },
  ],
  // A hundred cards a day from one address, counted under a keyed hash (tinier/brake.ts); the key is this Worker's own
  // secret BRAKE_KEY (`wrangler secret put BRAKE_KEY`), set once by hand, never here.
  // Only on its own domain: no workers.dev copy once this is live.
  "workers_dev": false,
  "routes": [
    { "pattern": "tinylittleoffice.com", "custom_domain": true },
    { "pattern": "www.tinylittleoffice.com", "custom_domain": true },
  ],
  // The site keeps no record of who asked for what; see "What it is not" in the README.
  "observability": { "enabled": false },
}
