# The address the site is published at; the link-preview tags, the canonical link, the sitemap and the structured data need it.
VITE_SITE_URL=https://tinylittleoffice.com/
# More names the dev server answers to, comma-separated (pefdev.exe.xyz and localhost always do).
# VITE_ALLOWED_HOSTS=
# The link shortener on this machine (npm run tinier:dev), reached through the dev server; put this in .env.development.
# VITE_TINIER=/tinier/
# The short-link service (tinier/) a production build uses, when it is not tinier.tinylittleoffice.com (docs/self-host.md).
# VITE_TINIER=https://tinier.tinylittleoffice.com/
# The npm token the deploy publishes the command line with (packages/doc, as `tinylittleoffice`); without one it skips npm.
# NPM_TOKEN=
